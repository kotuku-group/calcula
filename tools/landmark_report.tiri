-- $TIRI
--[[
Print the visual-landmark matrix as Markdown: every calibrated landmark in layout.tiri against the measurement in
reference/landmarks.json, with the deviation and the tolerance from the implementation proposal (0.5 mm for key
centres, 0.25 mm for screen and bezel edges).  Run after recalibrating:

   origo projects/calcula/tools/landmark_report.tiri out=docs/plans/apps/casio_fx_cg100/reference/visual_landmarks.md

Without 'out' the report is printed.  Note that print() writes to stderr, so shell redirection of stdout captures
nothing.
--]]

   import 'json'
   import '../scripts/ui/layout', '../scripts/keymap'

   local self = obj.find('self')
   local folder = self.workingPath
   local m = json.decode(io.readAll(folder .. '../reference/landmarks.json'))

   local out = array<str>
   local worst = { key=0, edge=0 }

   local function fmt(V:num):str return string.format('%.1f', V) end

   out.push('# Visual landmark matrix')
   out.push('')
   out.push('Generated by `projects/calcula/tools/landmark_report.tiri` from `projects/calcula/scripts/ui/layout.tiri`')
   out.push('and `projects/calcula/reference/landmarks.json`.  Units are logical (0.1 mm).  Status: ' ..
      f'**{layout.data.status}** — measured from the official Casio front render ' ..
      f'(SHA-256 `{m.source.sha256.sub(0, 16)}…`), not yet from a scan of a physical unit.')
   out.push('')
   out.push(f'Reference case outline: {m.case_px.x1 - m.case_px.x0} × {m.case_px.y1 - m.case_px.y0} px; scale ' ..
      f'{m.scale.x} × {m.scale.y} units/px; aspect error {fmt(m.scale.aspect_error * 100)}%.')
   out.push('')
   out.push('## Screen and bezel edges (tolerance 2.5 units)')
   out.push('')
   out.push('The LCD and its frame are deliberately extended upward to a 384 × 264 grid.  Their top edges are checked')
   out.push('at the calibrated position, and the layout value is given in brackets.')
   out.push('')
   out.push('| Landmark | Edge | Layout | Measured | Deviation | Pass |')
   out.push('|----------|------|--------|----------|-----------|------|')
   for _, pair in array<table> { { 'glass', 'glass' }, { 'lcdFrame', 'lcd_frame' }, { 'lcd', 'lcd' } } do
      local r, ref = layout.data[pair[0]], m.fixed[pair[1]]
      for _, edge in array<table> { { 'left', r.x, ref.x }, { 'top', r.calibratedTop ?? r.y, ref.y },
            { 'right', r.x + r.width, ref.x + ref.width }, { 'bottom', r.y + r.height, ref.y + ref.height } } do
         local dev = math.abs(edge[1] - edge[2])
         worst.edge = math.max(worst.edge, dev)
         local shown = fmt(edge[1])
         if (edge[0] is 'top') and r.calibratedTop then shown ..= f' (extended to {fmt(r.y)})' end
         out.push(f'| {pair[0]} | {edge[0]} | {shown} | {fmt(edge[2])} | {fmt(dev)} | ' ..
            ((dev <= 2.5) ? 'yes' : '**no**') .. ' |')
      end
   end

   out.push('')
   out.push('## Key centres and radii (tolerance 5 units)')
   out.push('')
   out.push('| Key | Layout centre | Measured centre | Deviation | Layout radius | Measured radii | Pass |')
   out.push('|-----|---------------|-----------------|-----------|---------------|----------------|------|')
   for _, k in keymap.keys do
      local g = k.geometry
      local ref = m.keys[g.measured]
      if ref then
         local dev = math.sqrt(((g.cx - ref.cx) ** 2) + ((g.cy - ref.cy) ** 2))
         worst.key = math.max(worst.key, dev)
         out.push(f'| {k.id} | {fmt(g.cx)}, {fmt(g.cy)} | {fmt(ref.cx)}, {fmt(ref.cy)} | {fmt(dev)} | ' ..
            f'{fmt(g.shape.radius)} | {fmt(ref.rx)} × {fmt(ref.ry)} | ' .. ((dev <= 5) ? 'yes' : '**no**') .. ' |')
      else
         local R = m.fixed.rocker
         out.push(f'| {k.id} | {fmt(g.cx)}, {fmt(g.cy)} | rocker {fmt(R.x)}, {fmt(R.y)}, {fmt(R.width)} × ' ..
            f'{fmt(R.height)} | — | pill {fmt(g.shape.width)} × {fmt(g.shape.height)} | — | yes |')
      end
   end

   out.push('')
   out.push('## Printed marks and legend rows')
   out.push('')
   out.push('| Landmark | Layout | Measured |')
   out.push('|----------|--------|----------|')
   for _, name in array<str> { 'brand', 'model', 'series' } do
      local r, ref = layout.data.marks[name], m.fixed[name]
      local moved = r.calibratedY and f' (raised from y {fmt(r.calibratedY)})' or ''
      out.push(f'| mark {name} | {fmt(r.x)}, {fmt(r.y)}, {fmt(r.width)} × {fmt(r.height)}{moved} | ' ..
         f'{fmt(ref.x)}, {fmt(ref.y)}, {fmt(ref.width)} × {fmt(ref.height)} |')
   end
   for _, name in array<str> { 'sci1', 'sci2', 'num1', 'num2', 'num3', 'num4' } do
      local measured = m.fixed['baseline_' .. name]
      out.push(f'| legend baseline {name} | {fmt(layout.data.legendRows[name].baseline)} | {fmt(measured.y)} |')
   end

   out.push('')
   out.push(f'Worst key-centre deviation: {fmt(worst.key)} units.  Worst screen/bezel edge deviation: ' ..
      f'{fmt(worst.edge)} units.')
   local report = out.concat('\n') .. '\n'
   local path = arg('out')
   if path then
      local file <close> = obj.new('file', { flags=FL_NEW|FL_WRITE, path=path })
      check file.acWrite(report)
      print(f'Wrote {path}')
   else
      print(report)
   end

-- $TIRI
--[[
The physical key matrix.  Each key has exactly one descriptor, and rendering, hit testing and dispatch all consume
it; there is no separate hit map.  A descriptor contains:

   id          Stable key identifier, also used as the layout key.
   name        Accessibility and diagnostic name.
   face        'light', 'dark' or 'shift': the key cap style.
   primary     Legend on the key top: { text=S, font=F } or { icon=NAME }.  An optional 'sub' adds a second line.
   shift       Green legend above-left of the key: { text=S } or { icon=NAME }, or nil.
   label       Text printed above a navigation key ('HOME', 'SHIFT', ...), or nil.
   action      Semantic action for an unmodified press.
   shiftAction Semantic action after Shift, or nil.
   bindings    Desktop keyboard bindings: { key=KEY_x, mods=KQ_x } or { char='c' } (matched on the typed character).
               A binding with tap=true holds the key down for as long as the desktop key is held, and commits on
               release only if no other key was used meanwhile.  This lets a desktop modifier double as a key.
   repeats     True if holding the key repeats it.
   geometry    Resolved geometry from layout.keyGeometry().

Command keys use Alt+letter bindings by default, so that plain letters remain available for typing.  The numeric keypad
is bound by key code as well as by typed character, so that it enters digits and operators whatever the Num Lock
state.

Calcula departs from the fx-CG100 where desktop conventions serve better:

   - The Alpha key and its A-LOCK, A-Z letters and orange legends are not reproduced.  Letters, space and quotes are
     typed on the desktop keyboard.  The key's position holds a HELP key (?), which opens the Calcula manual.
   - The ON key is an OFF key that closes the window.  There is no power-off state, so AC has no Shift+AC OFF
     function.
   - Ans, which the fx-CG100 places on Alpha, is Shift+EXE.  The approximate-result function that Shift+EXE gives on
     the fx-CG100 moves to Shift+÷.

The 'help' and 'close' actions are application commands: face.tiri passes them to the host instead of the
calculator.
--]]

   include 'display'
   import './ui/layout'

   namespace keymap { }

local function key(Fields:table!):table
   Fields.repeats ?= false
   Fields.bindings ?= array<table>
   Fields.geometry = layout.keyGeometry(Fields.id)
   return Fields
end

local function alt(Code:num!):table return { key=Code, mods=KQ_ALT } end
local function ctrl(Code:num!):table return { key=Code, mods=KQ_CTRL } end
local function plain(Code:num!):table return { key=Code } end
local function char(Char:str!):table return { char=Char } end
local function tap(Code:num!, Mods:num!):table return { key=Code, mods=Mods, tap=true } end

keymap.keys = array<table> {
   -- Navigation deck, row 1

   key({ id='off', name='Off (close the window)', face='dark', primary={ text='OFF', font='key' }, action='close',
      bindings=array<table> { ctrl(KEY_Q) } }),
   key({ id='home', name='Home', face='dark', primary={ icon='home' }, label='HOME', action='home',
      bindings=array<table> { plain(KEY_HOME) } }),
   key({ id='tab_prev', name='Previous tab', face='dark', primary={ icon='tab_prev' }, action='tab_prev',
      bindings=array<table> { { key=KEY_TAB, mods=KQ_SHIFT } } }),
   key({ id='up', name='Up', face='dark', primary={ icon='up' }, action='up', repeats=true,
      bindings=array<table> { plain(KEY_UP) } }),
   key({ id='tab_next', name='Next tab', face='dark', primary={ icon='tab_next' }, action='tab_next',
      bindings=array<table> { plain(KEY_TAB) } }),
   key({ id='page_up', name='Page up', face='dark', primary={ icon='page_up' }, action='page_up', repeats=true,
      bindings=array<table> { plain(KEY_PAGE_UP) } }),

   -- Navigation deck, row 2

   key({ id='settings', name='Settings', face='dark', primary={ icon='settings' }, label='SETTINGS',
      action='settings', bindings=array<table> { alt(KEY_E) } }),
   key({ id='back', name='Back', face='dark', primary={ icon='back' }, action='back',
      bindings=array<table> { plain(KEY_ESCAPE) } }),
   key({ id='left', name='Left', face='dark', primary={ icon='left' }, action='left', repeats=true,
      bindings=array<table> { plain(KEY_LEFT) } }),
   key({ id='ok', name='OK', face='dark', primary={ text='OK', font='key' }, action='ok',
      bindings=array<table> { alt(KEY_K) } }),
   key({ id='right', name='Right', face='dark', primary={ icon='right' }, action='right', repeats=true,
      bindings=array<table> { plain(KEY_RIGHT) } }),
   key({ id='page_down', name='Page down', face='dark', primary={ icon='page_down' }, action='page_down',
      repeats=true, bindings=array<table> { plain(KEY_PAGE_DOWN) } }),

   -- Navigation deck, row 3

   key({ id='shift', name='Shift', face='shift', primary={ icon='shift' }, label='SHIFT', action='shift',
      bindings=array<table> { alt(KEY_S), tap(KEY_L_SHIFT, KQ_SHIFT), tap(KEY_R_SHIFT, KQ_SHIFT) } }),
   key({ id='help', name='Help', face='light', primary={ text='?', font='key' }, label='HELP', action='help',

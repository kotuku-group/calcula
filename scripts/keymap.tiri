   key({ id='d3', name='3', face='light', primary={ text='3', font='digit' }, action='digit_3',
      bindings=array<table> { char('3'), plain(KEY_NP_3) } }),
   key({ id='plus', name='Plus', face='light', primary={ icon='plus' }, shift={ text='°′″' },
      action='plus', shiftAction='dms', bindings=array<table> { char('+'), plain(KEY_NP_PLUS) } }),
   key({ id='minus', name='Minus', face='light', primary={ icon='minus' }, shift={ text='(−)' },
      action='minus', shiftAction='negate', bindings=array<table> { char('-'), plain(KEY_NP_MINUS) } }),

   key({ id='d0', name='0', face='light', primary={ text='0', font='digit' }, shift={ icon='clip' },
      action='digit_0', shiftAction='clip', bindings=array<table> { char('0'), plain(KEY_NP_0) } }),
   key({ id='point', name='Decimal point', face='light', primary={ text='.', font='digit' }, shift={ icon='paste' },
      action='point', shiftAction='paste', bindings=array<table> { char('.'), plain(KEY_NP_DOT) } }),
   key({ id='exp10', name='Times ten to the power', face='light', primary={ icon='exp10' },
      shift={ icon='capture' }, action='exp10', shiftAction='capture', bindings=array<table> { alt(KEY_P) } }),
   key({ id='format', name='Format', face='light', primary={ icon='format' }, shift={ icon='format_menu' },
      action='format', shiftAction='format_menu', bindings=array<table> { alt(KEY_F) } }),

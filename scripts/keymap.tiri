}

-- Index keys by ID.

keymap.byID = { }
for _, k in keymap.keys do keymap.byID[k.id] = k end

-- Return the key descriptor for ID, raising an exception if the key does not exist.

keymap.get = function(ID:str!):table
   local result = keymap.byID[ID]
   result ?! raise f'Unknown key "{ID}"'
   return result
end

-- Find the key bound to a desktop key event.  Qualifiers is the KQ mask from the keyboard subscription, Code the KEY
-- value and Unicode the typed character code (0 if none).  Explicit key bindings take precedence over typed
-- characters.  Returns the key descriptor and the matching binding, or nil.  A desktop Shift key reports its own
-- qualifier when pressed, so its tap bindings are declared with mods=KQ_SHIFT.

keymap.KQ_MODIFIERS = KQ_ALT | KQ_SHIFT | KQ_CTRL

keymap.lookup = function(Qualifiers:num!, Code:num!, Unicode:num):<table, table>
   local mods = Qualifiers & keymap.KQ_MODIFIERS
   for _, k in keymap.keys do
      for _, b in k.bindings do
         if b.key and (b.key is Code) then
            local want = b.mods or 0
            if want is 0 then
               if mods is 0 then return k, b end
            elseif (mods & want) != 0 and (mods & ~want & keymap.KQ_MODIFIERS) is 0 then
               return k, b
            end
         end
      end
   end

   if Unicode and (Unicode > 0) and ((mods & (KQ_ALT | KQ_CTRL)) is 0) then
      local typed = string.char(Unicode)
      for _, k in keymap.keys do
         for _, b in k.bindings do
            if b.char is typed then return k, b end
         end
      end
   end
end

-- Return the key whose drawn outline contains logical point X, Y, or nil.

keymap.keyAt = function(X:num!, Y:num!):table
   for _, k in keymap.keys do
      if layout.pointInKey(k.id, X, Y) then return k end
   end
end

      bindings=array<table> { alt(KEY_T) } }),

   -- Scientific deck

   key({ id='xtt', name='x theta T Y', face='light', primary={ icon='xtt' }, shift={ icon='store' },
      action='var_x', shiftAction='store', bindings=array<table> { alt(KEY_X) } }),
   key({ id='fraction', name='Fraction', face='light', primary={ icon='fraction' }, shift={ icon='mixed_fraction' },
      action='fraction', shiftAction='mixed_fraction', bindings=array<table> { alt(KEY_SLASH) } }),
   key({ id='sqrt', name='Square root', face='light', primary={ icon='sqrt' }, shift={ icon='nth_root' },
      action='sqrt', shiftAction='nth_root', bindings=array<table> { alt(KEY_R) } }),
   key({ id='power', name='Power', face='light', primary={ icon='power' }, shift={ icon='log_base' },
      action='power', shiftAction='log_base', bindings=array<table> { char('^') } }),
   key({ id='square', name='Square', face='light', primary={ icon='square' }, shift={ text='log' },
      action='square', shiftAction='log', bindings=array<table> { alt(KEY_Q) } }),
   key({ id='exp', name='Exponential', face='light', primary={ icon='exp' }, shift={ text='ln' },
